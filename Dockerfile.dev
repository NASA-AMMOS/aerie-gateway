# Local development image for the gateway.
#
# The upstream Dockerfile expects dist/ to already be built on the host (CI runs
# `npm run build` before `docker build`, and `COPY . /app` picks up the result).
# That does not work when docker-compose builds straight from a source checkout,
# so this variant installs dependencies and builds inside the image.
#
# Note: the source copy deliberately happens before `npm ci`. There is no
# .dockerignore in this repo, so `COPY . /app` would drag in any host-built
# node_modules; running `npm ci` afterwards wipes and reinstalls them for the
# image's platform. Copying package files first would cache the dependency layer
# but leave macOS-built native modules in place.
FROM node:lts-alpine
RUN apk add --no-cache curl

COPY . /app
WORKDIR /app

# Install dependencies and build
RUN npm ci && npm run build

# define health check for container: /health route will return 200 if healthy
HEALTHCHECK --interval=2s --timeout=2s --start-period=2s --retries=15 \
  CMD /bin/sh -c 'curl -sf http://localhost:$PORT/health || exit 1'

CMD [ "npm", "start" ]
